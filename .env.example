# Public (browser + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BETA_LIVE_COPILOT=false

# Server-only (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=
# Team single sign-on (SAML through Supabase Auth; needs SAML turned on for the
# project, Pro plan and above). A Supabase personal access token that lets the
# server register each team's identity provider. Powerful: keep it server-only.
# Also add <app URL>/api/auth/callback to Authentication → URL configuration.
# SUPABASE_MANAGEMENT_TOKEN=
# SUPABASE_PROJECT_REF=   (read from NEXT_PUBLIC_SUPABASE_URL when unset)
# Teams prove they own each email domain with a DNS TXT record whose value is
# derived from this secret (falls back to SUPABASE_SERVICE_ROLE_KEY). Changing
# it means teams adding a new domain get a new record value.
# SSO_VERIFY_SECRET=

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Live copilot models (default gpt-4o-mini). "claude-*" ids use ANTHROPIC_API_KEY.
# COPILOT_GATE_MODEL=gpt-4o-mini
# COPILOT_ANSWER_MODEL=gpt-4o-mini        # fast model for most answers
# COPILOT_CODING_MODEL=claude-sonnet-5-5  # optional stronger model for coding and system design

# Speech-to-text (live copilot, server-only; used by the STT relay in server.ts)
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=en   # "multi" for nova-3 multilingual

# Billing (Stripe)
NEXT_PUBLIC_APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRICE_ID_PRO_EUR=
PRICE_ID_PRO_USD=

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron job authentication (minimum 32 characters, use secure random string).
# The custom server already runs reminders and the weekly digest every 5 minutes
# (/api/cron/notifications); CRON_SECRET lets an external scheduler call it too.
CRON_SECRET=
# NOTIFICATION_SCHEDULER=off

# Email (notifications, team invitations, weekly digest) through SendGrid.
# The from address must be a verified sender in SendGrid.
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Apex Round

# Device notifications (web push). Generate a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com
