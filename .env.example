# Apex Round environment. Copy to .env.local (dev) or set these in your host's
# dashboard (production). See docs/deploy.md for the full guide.
# "Build" = NEXT_PUBLIC_* values are inlined into the browser bundle at build
# time: pass them as Docker build args (and also as runtime env).

# --- App ---------------------------------------------------------------------
# Public https URL of the deployed app (no trailing slash). Used for Stripe
# redirects and as the allowed Origin for the STT WebSocket. [build + runtime]
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Live copilot is ON by default. Set to false or 0 to hide it. [build]
# NEXT_PUBLIC_BETA_LIVE_COPILOT=false
# Server (server.ts): port and bind address. The Dockerfile sets HOSTNAME=0.0.0.0.
# PORT=3000
# HOSTNAME=0.0.0.0

# --- Supabase (Auth + Postgres) ----------------------------------------------
# Project Settings -> API. [build + runtime]
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service role key. Never expose to the browser. Also used by the
# STT relay and the notification scheduler. [runtime]
SUPABASE_SERVICE_ROLE_KEY=
# Google sign-in is configured in the Supabase dashboard (Authentication ->
# Providers), not here.

# --- Team single sign-on (optional; SAML needs Supabase Pro or above) ---------
# Supabase personal access token that lets the server register each team's
# identity provider. Powerful: keep server-only. [runtime]
# SUPABASE_MANAGEMENT_TOKEN=
# Project ref; read from NEXT_PUBLIC_SUPABASE_URL when unset. [runtime]
# SUPABASE_PROJECT_REF=
# Secret that derives the DNS TXT value teams use to prove domain ownership
# (falls back to SUPABASE_SERVICE_ROLE_KEY). Changing it changes new records. [runtime]
# SSO_VERIFY_SECRET=

# --- LLM ---------------------------------------------------------------------
# Set OPENAI_API_KEY, ANTHROPIC_API_KEY or both. Each feature uses the model
# picked in Settings -> Answer model (or the COPILOT_* defaults below), and a
# model id picks its provider. LLM_PROVIDER (openai | anthropic | auto) only
# says which provider the live question gate tries first when both keys are
# set; auto (the default) tries OpenAI first. Without either key, the gate
# falls back to its heuristic and AI features say no model is set up.
# LLM_PROVIDER=auto
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Live copilot models (default gpt-4o-mini). "claude-*" ids use ANTHROPIC_API_KEY.
# COPILOT_GATE_MODEL=gpt-4o-mini
# COPILOT_ANSWER_MODEL=gpt-4o-mini        # fast model for most answers
# COPILOT_CODING_MODEL=claude-sonnet-5-5  # optional stronger model for coding and system design

# --- Speech-to-text: Deepgram (live copilot; used by the STT relay) ------------
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=en   # "multi" for nova-3 multilingual
# Override the Deepgram listen endpoint (self-hosted or proxy).
# DEEPGRAM_LISTEN_URL=

# --- Billing: Stripe -----------------------------------------------------------
# Webhook endpoint: <app URL>/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring monthly Pro price ids (price_...).
PRICE_ID_PRO_EUR=
PRICE_ID_PRO_USD=

# --- Rate limiting: Upstash Redis (optional) -----------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron ----------------------------------------------------------------------
# Minimum 32 characters, e.g. `openssl rand -hex 32`. External schedulers send it
# as `Authorization: Bearer <CRON_SECRET>` (never in the URL) to
# /api/cron/retention (required: schedule it daily) and /api/cron/notifications.
CRON_SECRET=
# The custom server already runs reminders and the weekly digest every 5 minutes
# (it sets INTERNAL_CRON_SECRET itself; do not set that one). Set to "off" to
# rely only on an external scheduler.
# NOTIFICATION_SCHEDULER=off

# --- Email: SendGrid (notifications, team invitations, weekly digest) ----------
# The from address must be a verified sender in SendGrid.
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Apex Round

# --- Device notifications: web push (VAPID) ------------------------------------
# Generate a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# --- Test only -----------------------------------------------------------------
# NEXT_PUBLIC_E2E_FAKE_AUDIO=1   # Playwright runs only; ignored in production builds
# NEXT_DIST_DIR=.next-e2e        # Build folder for end-to-end runs, so they can run beside the dev server (default .next)
